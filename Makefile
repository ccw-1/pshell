# Makefile - POSIX-compliant, portable
CC = cc
CFLAGS = -Wall -Wextra -std=c99 -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -g -O2 -pthread
LDFLAGS = -pthread

# Platform detection
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
    LDFLAGS += -lutil
endif
ifeq ($(UNAME_S),Darwin)
    LDFLAGS += -lutil
endif
ifeq ($(UNAME_S),SunOS)
    LDFLAGS += -lsocket -lnsl
endif

# Directories
SRC_DIR = src
BUILD_DIR = build
BIN_DIR = bin
INCLUDE_DIR = include

# Version: the VERSION file is the single source of truth. The header
# build/gen/pshell/version_gen.h is generated from it (plus git describe) and
# is only rewritten when its content changes.
PSHELL_VERSION := $(shell cat VERSION 2>/dev/null || echo 0.0.0)
BUILD_INFO := $(shell git describe --tags --always --dirty 2>/dev/null || echo unknown)
GEN_DIR = $(BUILD_DIR)/gen
GEN_HDR = $(GEN_DIR)/pshell/version_gen.h
INCLUDES = -I$(INCLUDE_DIR) -I$(GEN_DIR)

# Source files
DAEMON_SOURCES = $(shell find $(SRC_DIR)/daemon -name '*.c') \
                 $(shell find $(SRC_DIR)/http -name '*.c') \
                 $(shell find $(SRC_DIR)/socket -name '*.c' ! -name 'socket_client.c') \
                 $(shell find $(SRC_DIR)/session -name '*.c') \
                 $(shell find $(SRC_DIR)/pty -name '*.c') \
                 $(shell find $(SRC_DIR)/terminal -name '*.c') \
                 $(shell find $(SRC_DIR)/pattern -name '*.c') \
                 $(shell find $(SRC_DIR)/utils -name '*.c' ! -name 'test_stubs.c')

CLIENT_SOURCES = $(shell find $(SRC_DIR)/cli -name '*.c') \
                 $(SRC_DIR)/utils/logger.c \
                 $(SRC_DIR)/utils/json_simple.c \
                 $(SRC_DIR)/utils/string_utils.c

CTL_SOURCES = $(shell find $(SRC_DIR)/ctl -name '*.c') \
              $(SRC_DIR)/socket/socket_client.c \
              $(SRC_DIR)/utils/json_simple.c \
              $(SRC_DIR)/utils/string_utils.c \
              $(SRC_DIR)/utils/logger.c

MCP_SOURCES = $(SRC_DIR)/mcp/mcp_server.c \
              $(SRC_DIR)/socket/socket_client.c \
              $(SRC_DIR)/daemon/config.c \
              $(SRC_DIR)/utils/json_simple.c \
              $(SRC_DIR)/utils/string_utils.c \
              $(SRC_DIR)/utils/logger.c

DAEMON_OBJECTS = $(DAEMON_SOURCES:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)
CLIENT_OBJECTS = $(CLIENT_SOURCES:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)
CTL_OBJECTS = $(CTL_SOURCES:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)
MCP_OBJECTS = $(MCP_SOURCES:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)

# Targets
DAEMON = $(BIN_DIR)/pshell
CLIENT = $(BIN_DIR)/pshell-client
CTL = $(BIN_DIR)/pshellctl
MCP = $(BIN_DIR)/pshell-mcp

# Test sources
TEST_SOURCES = $(shell find tests/unit -name 'test_*.c')
TEST_OBJECTS = $(TEST_SOURCES:tests/unit/%.c=$(BUILD_DIR)/tests/%.o)
TEST_BINS = $(TEST_SOURCES:tests/unit/%.c=$(BIN_DIR)/tests/%)

.PHONY: all clean install test check mcp help version check-version FORCE

all: $(DAEMON) $(CLIENT) $(CTL) $(MCP)

$(DAEMON): $(DAEMON_OBJECTS)
	@mkdir -p $(BIN_DIR)
	@echo "Linking $@..."
	$(CC) -o $@ $(DAEMON_OBJECTS) -pthread -lpthread -lutil
	@echo "Built: $@"

$(CLIENT): $(CLIENT_OBJECTS)
	@mkdir -p $(BIN_DIR)
	@echo "Linking $@..."
	@$(CC) -o $@ $(CLIENT_OBJECTS) $(LDFLAGS)
	@echo "Built: $@"

$(CTL): $(CTL_OBJECTS)
	@mkdir -p $(BIN_DIR)
	@echo "Linking $@..."
	@$(CC) -o $@ $(CTL_OBJECTS) $(LDFLAGS)
	@echo "Built: $@"

mcp: $(MCP)

$(MCP): $(MCP_OBJECTS)
	@mkdir -p $(BIN_DIR)
	@echo "Linking $@..."
	@$(CC) -o $@ $(MCP_OBJECTS) $(LDFLAGS)
	@echo "Built: $@"

# Generated version header (rewritten only when the content changes)
$(GEN_HDR): FORCE
	@mkdir -p $(dir $@)
	@printf '%s\n' \
	  '/* Generated by make from VERSION and git; do not edit. */' \
	  '#define PSHELL_VERSION_MAJOR $(word 1,$(subst ., ,$(PSHELL_VERSION)))' \
	  '#define PSHELL_VERSION_MINOR $(word 2,$(subst ., ,$(PSHELL_VERSION)))' \
	  '#define PSHELL_VERSION_PATCH $(word 3,$(subst ., ,$(PSHELL_VERSION)))' \
	  '#define PSHELL_VERSION_STRING "$(PSHELL_VERSION)"' \
	  '#define PSHELL_BUILD_INFO "$(BUILD_INFO)"' > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi

FORCE:

# Objects that include pshell/version.h must be rebuilt when it changes
VERSION_OBJECTS = $(BUILD_DIR)/daemon/main.o $(BUILD_DIR)/mcp/mcp_server.o \
                  $(BUILD_DIR)/ctl/pshellctl.o $(BUILD_DIR)/cli/pshell_client.o
$(VERSION_OBJECTS): $(GEN_HDR)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(GEN_HDR)
	@mkdir -p $(dir $@)
	@echo "Compiling $<..."
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

version:
	@echo "$(PSHELL_VERSION) ($(BUILD_INFO))"

# Fail unless VERSION is MAJOR.MINOR.PATCH and CHANGELOG.md has a section for it
check-version:
	@echo "$(PSHELL_VERSION)" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$$' || \
	  { echo "VERSION '$(PSHELL_VERSION)' is not MAJOR.MINOR.PATCH" >&2; exit 1; }
	@grep -q '^## \[$(PSHELL_VERSION)\]' CHANGELOG.md || \
	  { echo "CHANGELOG.md has no section for $(PSHELL_VERSION)" >&2; exit 1; }
	@echo "Version $(PSHELL_VERSION): OK"

# Test targets
$(BUILD_DIR)/tests/%.o: tests/unit/%.c
	@mkdir -p $(dir $@)
	@echo "Compiling test $<..."
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/utils/test_stubs.o: $(SRC_DIR)/utils/test_stubs.c
	@mkdir -p $(dir $@)
	@echo "Compiling test stubs..."
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BIN_DIR)/tests/%: $(BUILD_DIR)/tests/%.o $(BUILD_DIR)/utils/test_stubs.o $(DAEMON_OBJECTS)
	@mkdir -p $(dir $@)
	@echo "Linking test $@..."
	@$(CC) $< $(BUILD_DIR)/utils/test_stubs.o $(filter-out $(BUILD_DIR)/daemon/main.o,$(DAEMON_OBJECTS)) -o $@ $(LDFLAGS)

test: $(TEST_BINS)
	@echo "Running unit tests..."
	@for test in $(TEST_BINS); do \
		echo "Running $$test..."; \
		$$test || exit 1; \
	done
	@echo "All tests passed!"

check: all
	@echo "Running integration tests..."
	@./tests/integration/test_full_workflow.sh

clean:
	@echo "Cleaning build artifacts..."
	@rm -rf $(BUILD_DIR) $(BIN_DIR)
	@echo "Clean complete."

install: all
	@echo "Installing pshell..."
	install -d $(DESTDIR)/usr/local/bin
	install -m 755 $(DAEMON) $(DESTDIR)/usr/local/bin/
	install -m 755 $(CLIENT) $(DESTDIR)/usr/local/bin/
	install -m 755 $(CTL) $(DESTDIR)/usr/local/bin/
	install -m 755 $(MCP) $(DESTDIR)/usr/local/bin/
	install -d $(DESTDIR)/usr/local/share/pshell/web
	cp -r web/* $(DESTDIR)/usr/local/share/pshell/web/
	install -d $(DESTDIR)/etc/pshell
	install -m 644 config/pshell.conf $(DESTDIR)/etc/pshell/
	@echo "Installation complete."

deploy: all
	@echo "deploying locally"
	ln -sf $(shell readlink -f $(DAEMON)) ~/local/bin/pshell
	ln -sf $(shell readlink -f $(CLIENT)) ~/local/bin/pshell-client
	ln -sf $(shell readlink -f $(CTL)) ~/local/bin/pshellctl
	ln -sf $(shell readlink -f $(MCP)) ~/local/bin/pshell-mcp
	ln -sf $(shell readlink -f config/pshell.conf) ~/local/etc/pshell.conf
	@echo "deploy complete."
	$(DAEMON) -c config/pshell.conf -f

DAEMON = $(BIN_DIR)/pshell
CLIENT = $(BIN_DIR)/pshell-client
CTL = $(BIN_DIR)/pshellctl

help:
	@echo "pshell - Portable Programmable Shell"
	@echo ""
	@echo "Targets:"
	@echo "  all      - Build all binaries (default)"
	@echo "  clean    - Remove build artifacts"
	@echo "  test     - Run unit tests"
	@echo "  check    - Run integration tests"
	@echo "  version  - Print the version and git build info"
	@echo "  check-version - Verify VERSION format and CHANGELOG entry"
	@echo "  mcp      - Build only the MCP server (pshell-mcp)"
	@echo "  install  - Install to system"
	@echo "  help     - Show this help"
	@echo ""
	@echo "Binaries:"
	@echo "  $(DAEMON)  - Main daemon"
	@echo "  $(CLIENT)  - HTTP client tool"
	@echo "  $(CTL)     - Socket control utility"
	@echo "  $(MCP)     - MCP server (Model Context Protocol over stdio)"
